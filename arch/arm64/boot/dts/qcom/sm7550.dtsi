                interrupts = <GIC_SPI 585 IRQ_TYPE_LEVEL_HIGH 0>;
                clock-names = "se";
                clocks = <&gcc GCC_QUPV3_WRAP0_S3_CLK>;
                interconnects =
                <&clk_virt MASTER_QUP_CORE_0 &clk_virt SLAVE_QUP_CORE_0>,
                <&gem_noc MASTER_APPSS_PROC &config_noc SLAVE_QUP_0>,
                <&aggre2_noc MASTER_QUP_0 &mc_virt  SLAVE_EBI1>;
                interconnect-names = "qup-core", "qup-config", "qup-memory";
                dmas = <&gpi_dma0 0 3 QCOM_GPI_SPI>,
                    <&gpi_dma0 1 3 QCOM_GPI_SPI>;
                dma-names = "tx", "rx";
                pinctrl-names = "default", "sleep";
                pinctrl-0 = <&qup_spi3_data_clk>, <&qup_spi3_cs>;

                #address-cells = <1>;
                #size-cells = <0>;

                status = "disabled";
            };

            i2c4: i2c@890000 {
                compatible = "qcom,geni-i2c";
                reg = <0 890000 0 0x4000>;
                interrupts = <GIC_SPI 586 IRQ_TYPE_LEVEL_HIGH 0>;
                clock-names = "se";
                clocks = <&gcc GCC_QUPV3_WRAP0_S4_CLK>;
                interconnects = 
		    	<&clk_virt MASTER_QUP_CORE_0 &clk_virt SLAVE_QUP_CORE_0>,
		    	<&gem_noc MASTER_APPSS_PROC &config_noc SLAVE_QUP_0>,
			    <&aggre2_noc MASTER_QUP_0 &mc_virt  SLAVE_EBI1>;
                interconnect-names = "qup-core", "qup-config", "qup-memory";
                dmas = <&gpi_dma0 0 4 QCOM_GPI_I2C>,
                    <&gpi_dma0 1 4 QCOM_GPI_I2C>;
                dma-names = "tx", "rx";
                pinctrl-0 = <&qup_i2c4_data_clk>;
                pinctrl-names = "default", "sleep";
                #address-cells = <1>;
                #size-cells = <0>;

                status = "disabled";
            };

            spi4: spi@890000 {
                compatible = "qcom,geni-spi";
                reg = <0 890000 0 0x4000>;
                interrupts = <GIC_SPI 586 IRQ_TYPE_LEVEL_HIGH 0>;
                clock-names = "se";
                clocks = <&gcc GCC_QUPV3_WRAP0_S4_CLK>;
                interconnects =
                <&clk_virt MASTER_QUP_CORE_0 &clk_virt SLAVE_QUP_CORE_0>,
                <&gem_noc MASTER_APPSS_PROC &config_noc SLAVE_QUP_0>,
                <&aggre2_noc MASTER_QUP_0 &mc_virt  SLAVE_EBI1>;
                interconnect-names = "qup-core", "qup-config", "qup-memory";
                dmas = <&gpi_dma0 0 4 QCOM_GPI_SPI>,
                    <&gpi_dma0 1 4 QCOM_GPI_SPI>;
                dma-names = "tx", "rx";
                pinctrl-names = "default", "sleep";
                pinctrl-0 = <&qup_spi4_data_clk>, <&qup_spi4_cs>;

                #address-cells = <1>;
                #size-cells = <0>;

                status = "disabled";
            };

            /* Debug UART Instance */
            uart5: qcom,qup_uart@894000 {
                compatible = "qcom,geni-debug-uart";
                reg = <0 0x894000 0 0x4000>;
                interrupts = <GIC_SPI 587 IRQ_TYPE_LEVEL_HIGH 0>;
                
                clocks = <&gcc GCC_QUPV3_WRAP0_S5_CLK>;
                clock-names = "se";

                interconnects =
                <&clk_virt MASTER_QUP_CORE_0 &clk_virt SLAVE_QUP_CORE_0>,
                <&gem_noc MASTER_APPSS_PROC &config_noc SLAVE_QUP_0>,
                <&aggre2_noc MASTER_QUP_0 &mc_virt  SLAVE_EBI1>;
                interconnect-names = "qup-core", "qup-config", "qup-memory";

                pinctrl-0 = <&qup_uart5_default>;
                pinctrl-names = "default", "sleep";

                status = "disabled";
            };

            i2c6: i2c@898000 {
                compatible = "qcom,geni-i2c";
                reg = <0 898000 0 0x4000>;
                interrupts = <GIC_SPI 461 IRQ_TYPE_LEVEL_HIGH 0>;
                clock-names = "se";
                clocks = <&gcc GCC_QUPV3_WRAP0_S6_CLK>;
                interconnects = 
                <&clk_virt MASTER_QUP_CORE_0 &clk_virt SLAVE_QUP_CORE_0>,
                <&gem_noc MASTER_APPSS_PROC &config_noc SLAVE_QUP_0>,
                <&aggre2_noc MASTER_QUP_0 &mc_virt  SLAVE_EBI1>;
                interconnect-names = "qup-core", "qup-config", "qup-memory";
