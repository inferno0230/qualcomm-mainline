            };

            i2c7: i2c@89c000 {
                compatible = "qcom,geni-i2c";
                reg = <0 89c000 0 0x4000>;
                interrupts = <GIC_SPI 462 IRQ_TYPE_LEVEL_HIGH 0>;
                clock-names = "se";
                clocks = <&gcc GCC_QUPV3_WRAP0_S7_CLK>;
                interconnects = 
                <&clk_virt MASTER_QUP_CORE_0 &clk_virt SLAVE_QUP_CORE_0>,
